# Local development. On Render these are supplied by render.yaml instead.
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bia

# Comma-separated list of browser origins allowed to call the API.
# Leave empty when the API also serves the client (the Render setup).
CLIENT_ORIGIN=http://localhost:5173

# Apply sql/schema.sql and sql/seed.sql on boot.
RUN_MIGRATIONS=true

# Nightly public-data refresh (World Bank / ClinicalTrials.gov).
ENABLE_PUBLIC_SYNC=true

# Optional. Unset lets the app pick TLS automatically from the database host:
# on for Render's external hostname, off for its internal one and for localhost.
# DATABASE_SSL=true

# Optional. Defaults to a directory inside the OS temp dir.
# UPLOAD_DIR=./uploads
